<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for the Phase 2 HAL plug-in bundle: build/Mbox3Driver.driver/Contents/Info.plist.
  build.sh substitutes @VERSION@. The factory UUID below is this project's own (generated with uuidgen);
  443ABAB8-E7B3-491A-B985-BEB9187030DB is Apple's fixed kAudioServerPlugInTypeUUID.
-->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleExecutable</key><string>Mbox3Driver</string>
    <key>CFBundleIdentifier</key><string>io.github.fpm8588.mbox3driver</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleName</key><string>Mbox3Driver</string>
    <key>CFBundlePackageType</key><string>BNDL</string>
    <key>CFBundleShortVersionString</key><string>@VERSION@</string>
    <key>CFBundleVersion</key><string>@VERSION@</string>
    <key>LSMinimumSystemVersion</key><string>13.0</string>

    <key>CFPlugInDynamicRegistration</key><string>NO</string>
    <key>CFPlugInFactories</key>
    <dict>
        <key>4F1C2B6E-9A57-4D0B-8E3A-6B2D7C9E1A40</key><string>Mbox3Driver_Create</string>
    </dict>
    <key>CFPlugInTypes</key>
    <dict>
        <key>443ABAB8-E7B3-491A-B985-BEB9187030DB</key>
        <array><string>4F1C2B6E-9A57-4D0B-8E3A-6B2D7C9E1A40</string></array>
    </dict>

    <!-- Lets the sandboxed coreaudiod driver process open the USB user clients.
         Without this: "deny iokit-open IOUSBDeviceUserClientV2" in the log and no device. -->
    <key>AudioServerPlugIn_IOKitUserClientClasses</key>
    <array>
        <string>AppleUSBHostDeviceUserClient</string>
        <string>AppleUSBHostInterfaceUserClient</string>
        <string>IOUSBDeviceUserClientV2</string>
        <string>IOUSBInterfaceUserClientV3</string>
    </array>
</dict>
</plist>
